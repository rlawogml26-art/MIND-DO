// DB 스키마 (데이터 담당). 글자 수 제한은 shared/의 제한 상수와 같아야 한다.
// 구조 기준: 요구사항 정의서 v2.1 (그룹 · 날짜별 공동 티켓 · 멤버별 개인 티켓)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7은 접속 주소(url)를 이 파일이 아니라 prisma.config.ts에서 읽는다.
datasource db {
  provider = "mysql"
}

enum TicketStatus {
  DRAFT
  COMPLETED
}

enum AssetType {
  STICKER
  FONT
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  nickname        String    @db.VarChar(15)
  // 마이페이지 소개(선택, 최대 15자 = shared의 PROFILE_BIO_MAX). 비우면 NULL.
  bio             String?   @db.VarChar(15)
  profileImageKey String?   @map("profile_image_key") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tickets              Ticket[]
  refreshTokens        RefreshToken[]
  groupMemberships     GroupMember[]
  ledGroups            Group[]               @relation("GroupLeader")
  createdInvites       GroupInvite[]         @relation("InviteCreator")
  createdSharedTickets SharedTicket[]
  sharedTicketInvites  SharedTicketInvitee[]
  purchases            Purchase[]
  subscriptions        Subscription[]
  aiRegenerationUsages AiRegenerationUsage[]

  @@map("users")
}

// 원본 토큰은 저장하지 않고 SHA-256 해시만 저장한다 (AGENTS.md).
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// is_default: 계정마다 1개씩 있는 기본 1인 그룹(회원가입 때 생성). 멤버를 초대할 수 없고(초대하면 새 그룹을 만든다),
// 참여 그룹 수 제한(4개)에서 빠진다. 보관함에서 공동 그룹 티켓과 나눠 보여줄 때도 이 값으로 구분한다.
// deleted_at: 혼자 남은 그룹장이 나가 그룹이 삭제된 시각. 공동 티켓은 지울 수 없어서 행은 남긴다.
model Group {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(8)
  isDefault  Boolean   @default(false) @map("is_default")
  leaderId   Int       @map("leader_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  leader               User                  @relation("GroupLeader", fields: [leaderId], references: [id])
  members              GroupMember[]
  invites              GroupInvite[]
  sharedTickets        SharedTicket[]
  aiRegenerationUsages AiRegenerationUsage[]

  @@map("groups")
}

// 탈퇴해도 행을 지우지 않고 left_at만 기록한다. 그룹 인원(최대 6명)은 left_at이 비어 있는 행으로 센다.
model GroupMember {
  id       Int       @id @default(autoincrement())
  groupId  Int       @map("group_id")
  userId   Int       @map("user_id")
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_members")
}

// 링크·QR 공용. 유효 기간 안에는 여러 명이 쓸 수 있다(1회용 아님).
// 그룹 멤버 누구나 만들 수 있고, 새 링크를 만들어도 다른 링크는 그대로 유효하다 (AGENTS.md v1.18).
// revoked_at은 그룹장이 그룹의 모든 링크를 한꺼번에 무효로 만들 때 쓴다 (발표 이후 구현).
// 원본 토큰은 저장하지 않고 SHA-256 해시만 저장한다 (AGENTS.md).
model GroupInvite {
  id          Int       @id @default(autoincrement())
  groupId     Int       @map("group_id")
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  createdById Int       @map("created_by")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  group     Group @relation(fields: [groupId], references: [id])
  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id])

  @@map("group_invites")
}

// 그룹별 날짜당 1개. 삭제 기능은 없다. 장소 필드는 없다(요구사항 정의서 v2.2).
// group_name은 생성 당시 그룹명이다. 나중에 그룹명을 바꿔도 이 값은 바꾸지 않는다.
model SharedTicket {
  id         Int      @id @default(autoincrement())
  groupId    Int      @map("group_id")
  ticketDate DateTime @map("ticket_date") @db.Date
  title      String?  @db.VarChar(12)
  groupName  String   @map("group_name") @db.VarChar(8)
  creatorId  Int      @map("creator_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  group    Group                 @relation(fields: [groupId], references: [id])
  creator  User                  @relation(fields: [creatorId], references: [id])
  tickets  Ticket[]
  invitees SharedTicketInvitee[]

  @@unique([groupId, ticketDate])
  @@map("shared_tickets")
}

// 날짜별 참여자(초대자). 생성자 본인도 생성 시 함께 넣는다.
// 개인 티켓 슬롯은 이 표에 있는 사람에게만 생긴다. 초대에서 제외하면 행을 지운다.
// nickname은 초대 당시 닉네임이다. 나중에 닉네임을 바꿔도 이 값은 바꾸지 않는다.
model SharedTicketInvitee {
  id             Int      @id @default(autoincrement())
  sharedTicketId Int      @map("shared_ticket_id")
  userId         Int      @map("user_id")
  nickname       String   @db.VarChar(15)
  // 이 슬롯에서 AI 초안을 받은 횟수. 초안은 개인 티켓을 저장하기 전에 만들어서 티켓이 아니라 슬롯에 센다.
  // 일반 사용자는 슬롯당 1회. 초안을 돌려주지 못한 실패는 세지 않는다.
  aiDraftCount   Int      @default(0) @map("ai_draft_count")
  invitedAt      DateTime @default(now()) @map("invited_at")

  sharedTicket SharedTicket @relation(fields: [sharedTicketId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([sharedTicketId, userId])
  @@map("shared_ticket_invitees")
}

// 개인 티켓. 공동 티켓의 슬롯에서만 만든다. shared_ticket_id가 비어 있으면 그룹 연결이 제거된 티켓이다.
// 소유자가 원본을 지울 때(deleted_at)는 shared_ticket_id도 비워서 그룹에서도 빠지게 한다.
model Ticket {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  sharedTicketId Int?         @map("shared_ticket_id")
  // 발권 때 서버가 공동 티켓의 ticket_date를 복사한다(앱에서 받지 않음). 연결이 끊겨도 보관함·달력에 날짜가 남게 하려고 따로 둔다.
  visitDate      DateTime     @map("visit_date") @db.Date
  memo           String?      @db.VarChar(500)
  design         Json?
  status         TicketStatus @default(DRAFT)
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  // 티켓은 행을 지우지 않고 이 값을 채워 삭제 처리한다(소프트 삭제). 조회 시 항상 null인 것만 쓴다.
  deletedAt      DateTime?    @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id])
  sharedTicket SharedTicket? @relation(fields: [sharedTicketId], references: [id])
  images       TicketImage[]

  // 내 티켓 목록 조회(user_id + 삭제 안 됨 + 날짜 정렬)용
  @@index([userId, deletedAt, visitDate])
  // 같은 공동 티켓에 한 사람이 개인 티켓을 두 번 만들지 못하게 한다 (NFR-08)
  @@unique([sharedTicketId, userId])
  @@map("tickets")
}

model TicketImage {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  // URL이 아니라 S3 저장 위치(key)만 저장한다. 링크는 조회 시 Presigned URL로 만든다.
  s3Key     String   @unique @map("s3_key") @db.VarChar(255)
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // 티켓은 소프트 삭제라 이 Cascade는 평소에 동작하지 않는다.
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, sortOrder])
  @@map("ticket_images")
}

// Store 판매 에셋(스티커·폰트, 요구사항 정의서 v2.2). 템플릿·프레임은 판매하지 않는다.
model Asset {
  id          Int       @id @default(autoincrement())
  type        AssetType
  name        String    @db.VarChar(100)
  s3Key       String    @unique @map("s3_key") @db.VarChar(255)
  price       Int
  vipIncluded Boolean   @default(false) @map("vip_included")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  purchases Purchase[]

  @@map("assets")
}

model Purchase {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  assetId     Int       @map("asset_id")
  paidPrice   Int       @map("paid_price")
  purchasedAt DateTime  @default(now()) @map("purchased_at")
  refundedAt  DateTime? @map("refunded_at")

  user  User  @relation(fields: [userId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id])

  @@unique([userId, assetId])
  @@map("purchases")
}

model Subscription {
  id         Int              @id @default(autoincrement())
  userId     Int              @map("user_id")
  plan       SubscriptionPlan
  startedAt  DateTime         @default(now()) @map("started_at")
  expiresAt  DateTime         @map("expires_at")
  canceledAt DateTime?        @map("canceled_at")

  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

// VIP의 AI 초안 재생성 횟수(사용자별·그룹당 하루 3회). usage_date는 한국시간(KST) 날짜라
// 날짜가 바뀌면 새 행이 되어 0시에 초기화된다. 서버 메모리에 두면 서버 교체 시 사라져 DB에 둔다.
model AiRegenerationUsage {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  groupId   Int      @map("group_id")
  usageDate DateTime @map("usage_date") @db.Date
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId, usageDate])
  @@map("ai_regeneration_usages")
}
