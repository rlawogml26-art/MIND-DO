// DB 스키마 (데이터 담당). 글자 수 제한은 shared/의 제한 상수와 같아야 한다.
// 구조 기준: 요구사항 정의서 v2.1 (그룹 · 날짜별 공동 티켓 · 멤버별 개인 티켓)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7은 접속 주소(url)를 이 파일이 아니라 prisma.config.ts에서 읽는다.
datasource db {
  provider = "mysql"
}

enum TicketStatus {
  DRAFT
  COMPLETED
}

enum AssetType {
  FRAME
  STICKER
  FONT
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  nickname        String    @db.VarChar(15)
  profileImageKey String?   @map("profile_image_key") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tickets              Ticket[]
  refreshTokens        RefreshToken[]
  groupMemberships     GroupMember[]
  ledGroups            Group[]               @relation("GroupLeader")
  createdInvites       GroupInvite[]         @relation("InviteCreator")
  createdSharedTickets SharedTicket[]
  sharedTicketInvites  SharedTicketInvitee[]
  purchases            Purchase[]
  subscriptions        Subscription[]

  @@map("users")
}

// 원본 토큰은 저장하지 않고 SHA-256 해시만 저장한다 (AGENTS.md).
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(15)
  leaderId  Int      @map("leader_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leader        User           @relation("GroupLeader", fields: [leaderId], references: [id])
  members       GroupMember[]
  invites       GroupInvite[]
  sharedTickets SharedTicket[]

  @@map("groups")
}

// 탈퇴해도 행을 지우지 않고 left_at만 기록한다. 그룹 인원(최대 6명)은 left_at이 비어 있는 행으로 센다.
model GroupMember {
  id       Int       @id @default(autoincrement())
  groupId  Int       @map("group_id")
  userId   Int       @map("user_id")
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_members")
}

// 링크·QR 공용. 유효 기간 안에는 여러 명이 쓸 수 있다(1회용 아님).
// 새 링크를 만들면 그 그룹의 이전 링크에 revoked_at을 기록해 무효로 만든다.
model GroupInvite {
  id          Int       @id @default(autoincrement())
  groupId     Int       @map("group_id")
  token       String    @unique @db.VarChar(64)
  createdById Int       @map("created_by")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  group     Group @relation(fields: [groupId], references: [id])
  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id])

  @@map("group_invites")
}

// 그룹별 날짜당 1개. 삭제 기능은 없다.
model SharedTicket {
  id         Int      @id @default(autoincrement())
  groupId    Int      @map("group_id")
  ticketDate DateTime @map("ticket_date") @db.Date
  title      String?  @db.VarChar(10)
  // 선택 입력. 글자 수는 미확정이라 기존 장소 제한(15자)을 임시로 쓴다.
  location   String?  @db.VarChar(15)
  creatorId  Int      @map("creator_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  group    Group                 @relation(fields: [groupId], references: [id])
  creator  User                  @relation(fields: [creatorId], references: [id])
  tickets  Ticket[]
  invitees SharedTicketInvitee[]

  @@unique([groupId, ticketDate])
  @@map("shared_tickets")
}

// 공동 티켓 생성자가 그룹 멤버 중에서 고른 초대자. 생성자 본인도 생성 시 함께 넣는다.
// 개인 티켓 슬롯은 이 표에 있는 사람에게만 생긴다. 초대에서 제외하면 행을 지운다.
model SharedTicketInvitee {
  id             Int      @id @default(autoincrement())
  sharedTicketId Int      @map("shared_ticket_id")
  userId         Int      @map("user_id")
  invitedAt      DateTime @default(now()) @map("invited_at")

  sharedTicket SharedTicket @relation(fields: [sharedTicketId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([sharedTicketId, userId])
  @@map("shared_ticket_invitees")
}

// 개인 티켓. shared_ticket_id가 비어 있으면 혼자 만든 티켓이거나 그룹 연결이 제거된 티켓이다.
// 소유자가 원본을 지울 때(deleted_at)는 shared_ticket_id도 비워서 그룹에서도 빠지게 한다.
model Ticket {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  sharedTicketId Int?         @map("shared_ticket_id")
  visitDate      DateTime     @map("visit_date") @db.Date
  memo           String?      @db.VarChar(500)
  design         Json?
  status         TicketStatus @default(DRAFT)
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  // 티켓은 행을 지우지 않고 이 값을 채워 삭제 처리한다(소프트 삭제). 조회 시 항상 null인 것만 쓴다.
  deletedAt      DateTime?    @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id])
  sharedTicket SharedTicket? @relation(fields: [sharedTicketId], references: [id])
  images       TicketImage[]

  // 내 티켓 목록 조회(user_id + 삭제 안 됨 + 날짜 정렬)용
  @@index([userId, deletedAt, visitDate])
  // 같은 공동 티켓에 한 사람이 개인 티켓을 두 번 만들지 못하게 한다 (NFR-08)
  @@unique([sharedTicketId, userId])
  @@map("tickets")
}

model TicketImage {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  // URL이 아니라 S3 저장 위치(key)만 저장한다. 링크는 조회 시 Presigned URL로 만든다.
  s3Key     String   @unique @map("s3_key") @db.VarChar(255)
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // 티켓은 소프트 삭제라 이 Cascade는 평소에 동작하지 않는다.
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, sortOrder])
  @@map("ticket_images")
}

// Store 판매 에셋. 템플릿은 판매하지 않는다.
model Asset {
  id          Int       @id @default(autoincrement())
  type        AssetType
  name        String    @db.VarChar(100)
  s3Key       String    @unique @map("s3_key") @db.VarChar(255)
  price       Int
  vipIncluded Boolean   @default(false) @map("vip_included")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  purchases Purchase[]

  @@map("assets")
}

model Purchase {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  assetId     Int       @map("asset_id")
  paidPrice   Int       @map("paid_price")
  purchasedAt DateTime  @default(now()) @map("purchased_at")
  refundedAt  DateTime? @map("refunded_at")

  user  User  @relation(fields: [userId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id])

  @@unique([userId, assetId])
  @@map("purchases")
}

model Subscription {
  id         Int              @id @default(autoincrement())
  userId     Int              @map("user_id")
  plan       SubscriptionPlan
  startedAt  DateTime         @default(now()) @map("started_at")
  expiresAt  DateTime         @map("expires_at")
  canceledAt DateTime?        @map("canceled_at")

  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}
