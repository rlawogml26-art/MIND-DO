SWAGGER_ENABLED=

# MySQL 접속 주소 (형식: mysql://사용자:비밀번호@호스트:3306/DB이름)
DATABASE_URL=
# DB TLS용 CA 인증서 파일 경로. 비워 두면 TLS 없이 연결한다(로컬 개발용)
DB_SSL_CA_PATH=

# 테스트 사용자 seed (backend/prisma/seed.ts)
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=

# AI 초안 (AGENTS.md "AI 초안"). 기본값 없음: 비어 있으면 AI 초안 기능을 쓸 때 에러가 난다
# 리전·모델 ID (dev 값: ap-northeast-2, global.amazon.nova-2-lite-v1:0)
AWS_REGION=
BEDROCK_MODEL_ID=
# Bedrock 1회 호출 제한 시간(밀리초)
AI_TIMEOUT_MS=
# AI에 보내는 사진: 긴 변(px), JPEG 품질(1~100), 사진당 주요 색 개수
AI_IMAGE_MAX_SIDE=
AI_IMAGE_JPEG_QUALITY=
AI_COLORS_PER_PHOTO=
# AI 응답 최대 길이(토큰), 무작위성(0~1)
AI_MAX_TOKENS=
AI_TEMPERATURE=
