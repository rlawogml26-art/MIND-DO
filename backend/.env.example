SWAGGER_ENABLED=

# 회원가입 로그인 쿠키
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
COOKIE_SECURE=

# 그룹 초대 링크 (TTL 시간 단위, 공유 URL의 origin)
INVITE_LINK_TTL_HOURS=
INVITE_BASE_URL=

# MySQL 접속 주소 (형식: mysql://사용자:비밀번호@호스트:3306/DB이름)
DATABASE_URL=
# DB TLS용 CA 인증서 파일 경로. 비워 두면 TLS 없이 연결한다(로컬 개발용)
DB_SSL_CA_PATH=

# 테스트 사용자 seed (backend/prisma/seed.ts)
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
